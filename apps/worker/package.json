    "@market/db": "workspace:*",
    "@market/market-data": "workspace:*",
    "@market/news": "workspace:*",
    "@market/ownership": "workspace:*",
    "@market/push": "workspace:*",
    "@market/screener": "workspace:*",
    "bullmq": "6.3.10",
    "ioredis": "6.0.0",
    "kysely": "0.29.6",
    "pino": "10.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.5"
