{
  "name": "market-analysis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "prepare": "lefthook install || true",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:shim": "pnpm --filter @market/db run shim",
    "db:migrate": "pnpm --filter @market/db run migrate",
    "db:rollback": "pnpm --filter @market/db run rollback",
    "db:roundtrip": "pnpm --filter @market/db run roundtrip",
    "db:codegen": "pnpm --filter @market/db run codegen",
    "db:codegen:check": "pnpm --filter @market/db run codegen:check",
    "licenses:check": "node scripts/check-licenses.mjs",
    "worker": "pnpm --filter @market/worker run cli",
    "test:acceptance": "turbo run test:acceptance --concurrency=1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "lefthook": "2.1.15",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
