# Copy to .env and fill in real values locally. Never commit .env.
# Placeholders only: every value below is fake.

# ---- shared ----
APP_ENV=local                 # local | test | preview | staging | production
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/market

# ---- worker (and the web app's live updates) ----
REDIS_URL=redis://localhost:6379
DATA_PROVIDER_PRIMARY=synthetic   # tiingo | synthetic (synthetic is refused in production)
DATA_PROVIDER_FALLBACK=none       # tiingo | synthetic | none
TIINGO_API_KEY=                   # required when tiingo is primary or fallback
TIINGO_HOURLY_LIMIT=              # blank = free tier (50/hour); set for a paid plan
TIINGO_DAILY_LIMIT=               # blank = free tier (1,000/day)
UNIVERSE_FILE=                    # blank = config/universe.json

# SEC EDGAR fair-access policy: declared User-Agent "<APP_NAME> <SEC_CONTACT_EMAIL>"
EDGAR_ENABLED=false
APP_NAME=Market Analysis
SEC_CONTACT_EMAIL=admin@example.com

FRED_ENABLED=false
FRED_API_KEY=                     # free key from https://fred.stlouisfed.org/docs/api/api_key.html

FINNHUB_API_KEY=                  # optional: earnings calendar and company news (free personal key)

# optional: short interest from FINRA's Query API. A free "Public" credential from FINRA's API
# Console (individual account; docs/RUNBOOK.md). Personal, non-commercial use only.
FINRA_API_CLIENT_ID=
FINRA_API_CLIENT_SECRET=

# optional: AI features (news sentiment now; questions about your data later) on your own
# Anthropic API key. Requests stop for the month once the cap is spent.
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=10
AI_SENTIMENT_MODEL=claude-haiku-4-5-20251001

# Alert emails go only to the owner (personal use). Resend's test sender (the default FROM)
# delivers only to the address your Resend account was created with: use that one.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=Market Analysis <onboarding@resend.dev>
ALERT_DAILY_CAP=20
# Where links in alert emails point: the address you open the app at (your Tailscale HTTPS
# address once phone access is set up).
APP_BASE_URL=http://localhost:3000

# ---- web (owner login; run `pnpm web:hash-password` and paste its two lines here) ----
OWNER_PASSWORD_HASH=
SESSION_SECRET=
WEB_ALLOWED_HOSTS=                # extra host names besides localhost, comma-separated

# ---- tests (integration suites create throwaway databases from this server) ----
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
TEST_REDIS_URL=redis://localhost:6379
