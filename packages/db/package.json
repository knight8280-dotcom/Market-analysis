{
  "name": "@market/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/migrations.ts",
    "./security": "./src/security.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts",
    "shim": "tsx scripts/shim.ts",
    "migrate": "tsx scripts/migrate.ts",
    "rollback": "tsx scripts/rollback.ts",
    "roundtrip": "tsx scripts/roundtrip.ts",
    "codegen": "tsx scripts/codegen.ts",
    "codegen:check": "tsx scripts/codegen.ts --check"
  },
  "dependencies": {
    "kysely": "0.29.6",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0"
  }
}
